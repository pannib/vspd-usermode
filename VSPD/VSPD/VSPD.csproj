<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vspd.Core\Vspd.Core.csproj" />
    <ProjectReference Include="..\Vspd.Service\Vspd.Service.csproj" />
    <ProjectReference Include="..\Vspd.Bus\Vspd.Bus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="vspd.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 将内核驱动包（vspd.inf / vspd.sys 等）复制到输出目录的 Driver 子目录，
       这样“开启驱动”按钮能在运行时找到驱动包。vspd.sys 需先通过 CI 或本地 WDK 构建。 -->
  <Target Name="CopyDriverPackage" AfterTargets="Build">
    <ItemGroup>
      <_DrvFiles Include="$(MSBuildThisFileDirectory)..\Vspd.Driver\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DrvFiles)"
          DestinationFiles="@(_DrvFiles->'$(OutDir)Driver\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
